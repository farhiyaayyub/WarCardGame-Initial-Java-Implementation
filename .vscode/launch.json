{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "War Card Game UTF-8",
      "request": "launch",
      "mainClass": "cardgame.WarCardGame",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "vmArgs": "-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8"
    }
  ]
}
